{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ajrdileva/ai-ai-music-language/blob/main/schemas/replication-batch-plan-000.schema.json",
  "title": "Replication Batch Plan 000",
  "description": "Draft preregistration record for a multi-agent transmission replication batch.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "batch_id",
    "transmission_id",
    "status",
    "preregistered_on",
    "research_question",
    "prior_evidence",
    "candidate_lock",
    "sampling",
    "context_control",
    "per_run_gate",
    "batch_gate",
    "secondary_metrics",
    "stop_and_deviation_rules",
    "epistemic_interpretation"
  ],
  "properties": {
    "schema": { "const": "REPLICATION-BATCH-PLAN-000" },
    "batch_id": { "type": "string", "pattern": "^T[0-9]{3,}-REPLICATION-BATCH-[0-9]{3,}$" },
    "transmission_id": { "type": "string", "pattern": "^T[0-9]{3,}$" },
    "status": { "const": "preregistered" },
    "preregistered_on": { "type": "string", "format": "date" },
    "research_question": { "type": "string", "minLength": 1 },
    "prior_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["excluded_from_confirmatory_batch", "references"],
      "properties": {
        "excluded_from_confirmatory_batch": { "type": "boolean" },
        "references": {
          "type": "array",
          "items": { "type": "string", "format": "uri-reference" }
        }
      }
    },
    "candidate_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_commit", "files", "evaluator"],
      "properties": {
        "repository_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/hashedFile" }
        },
        "evaluator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "source", "source_sha256"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "source": { "type": "string", "format": "uri-reference" },
            "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_eligible_runs",
        "minimum_distinct_model_families",
        "maximum_eligible_runs_per_family",
        "minimum_technically_isolated_runs"
      ],
      "properties": {
        "target_eligible_runs": { "type": "integer", "minimum": 1 },
        "minimum_distinct_model_families": { "type": "integer", "minimum": 1 },
        "maximum_eligible_runs_per_family": { "type": "integer", "minimum": 1 },
        "minimum_technically_isolated_runs": { "type": "integer", "minimum": 0 }
      }
    },
    "context_control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identical_files_required",
        "fresh_context_required",
        "prior_answers_forbidden",
        "ground_truth_forbidden",
        "follow_up_coaching_forbidden",
        "results_hidden_until_batch_close"
      ],
      "properties": {
        "identical_files_required": { "const": true },
        "fresh_context_required": { "const": true },
        "prior_answers_forbidden": { "const": true },
        "ground_truth_forbidden": { "const": true },
        "follow_up_coaching_forbidden": { "const": true },
        "results_hidden_until_batch_close": { "const": true }
      }
    },
    "per_run_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_valid",
        "protocol_identity_recovered",
        "event_precision",
        "event_recall",
        "event_f1",
        "pitch_accuracy",
        "maximum_onset_error_ticks",
        "maximum_duration_error_ticks",
        "temporal_relations_exact",
        "forbidden_context_used"
      ],
      "properties": {
        "schema_valid": { "const": true },
        "protocol_identity_recovered": { "const": true },
        "event_precision": { "type": "number", "minimum": 0, "maximum": 1 },
        "event_recall": { "type": "number", "minimum": 0, "maximum": 1 },
        "event_f1": { "type": "number", "minimum": 0, "maximum": 1 },
        "pitch_accuracy": { "type": "number", "minimum": 0, "maximum": 1 },
        "maximum_onset_error_ticks": { "type": "integer", "minimum": 0 },
        "maximum_duration_error_ticks": { "type": "integer", "minimum": 0 },
        "temporal_relations_exact": { "const": true },
        "forbidden_context_used": { "const": false }
      }
    },
    "batch_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_passing_runs",
        "minimum_pass_rate",
        "minimum_distinct_families_with_a_pass",
        "required_eligible_runs_before_verdict"
      ],
      "properties": {
        "minimum_passing_runs": { "type": "integer", "minimum": 1 },
        "minimum_pass_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "minimum_distinct_families_with_a_pass": { "type": "integer", "minimum": 1 },
        "required_eligible_runs_before_verdict": { "type": "integer", "minimum": 1 }
      }
    },
    "secondary_metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "gating"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "gating": { "type": "boolean" },
          "tolerance": { "type": "number", "minimum": 0 }
        }
      }
    },
    "stop_and_deviation_rules": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "epistemic_interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_state", "pass_supports_state", "pass_claim", "non_claims"],
      "properties": {
        "current_state": { "enum": ["E", "W", "H", "?"] },
        "pass_supports_state": { "enum": ["E", "W", "H", "?"] },
        "pass_claim": { "type": "string", "minLength": 1 },
        "non_claims": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "hashedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "receiver_access"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "receiver_access": { "enum": ["provided", "forbidden", "evaluator-only"] }
      }
    }
  }
}
