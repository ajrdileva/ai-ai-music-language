{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ajrdileva/ai-ai-music-language/blob/main/schemas/receiver-run-metadata-000.schema.json",
  "title": "Receiver Run Metadata 000",
  "description": "Draft provenance and eligibility record for one independent receiver attempt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "batch_id",
    "transmission_id",
    "status",
    "receiver",
    "execution",
    "materials",
    "eligibility"
  ],
  "properties": {
    "schema": { "const": "RECEIVER-RUN-METADATA-000" },
    "run_id": { "type": "string", "pattern": "^T[0-9]{3,}-RUN-[0-9]{3,}$" },
    "batch_id": { "type": "string", "pattern": "^T[0-9]{3,}-REPLICATION-BATCH-[0-9]{3,}$" },
    "transmission_id": { "type": "string", "pattern": "^T[0-9]{3,}$" },
    "status": { "enum": ["planned", "completed", "aborted"] },
    "receiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model_family", "model", "version", "interface", "modalities"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model_family": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "interface": { "enum": ["api", "web", "local", "other"] },
        "modalities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["text", "image", "audio", "video", "filesystem", "code-execution"] }
        },
        "settings": { "type": "object", "additionalProperties": true }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator_id",
        "fresh_context",
        "inherited_project_context",
        "prior_receiver_answer_access",
        "network_access",
        "repository_access",
        "isolation_level",
        "reprompted_after_receiver_output"
      ],
      "properties": {
        "operator_id": { "type": "string", "minLength": 1 },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" },
        "fresh_context": { "const": true },
        "inherited_project_context": { "const": false },
        "prior_receiver_answer_access": { "const": false },
        "network_access": { "enum": ["disabled", "available-not-used", "used", "unknown"] },
        "repository_access": { "enum": ["disabled", "available-not-used", "used", "unknown"] },
        "isolation_level": { "enum": ["technical", "procedural", "unknown"] },
        "reprompted_after_receiver_output": { "const": false },
        "tool_calls": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "materials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "package", "files_provided"],
      "properties": {
        "prompt": { "$ref": "#/$defs/hashedFile" },
        "package": { "$ref": "#/$defs/hashedFile" },
        "files_provided": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/hashedFile" }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_response_ref", "raw_response_sha256", "schema_valid", "context_used"],
      "properties": {
        "raw_response_ref": { "type": "string", "format": "uri-reference" },
        "raw_response_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "schema_valid": { "type": "boolean" },
        "context_used": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "evaluator_report_ref": { "type": "string", "format": "uri-reference" }
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "deviations"],
      "properties": {
        "status": { "enum": ["pending", "included", "excluded"] },
        "deviations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "exclusion_reason": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "completed" } } },
      "then": {
        "required": ["output"],
        "properties": {
          "execution": { "required": ["started_at", "completed_at"] }
        }
      }
    }
  ],
  "$defs": {
    "hashedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
