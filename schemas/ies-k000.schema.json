{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ajrdileva/ai-ai-music-language/blob/main/schemas/ies-k000.schema.json",
  "title": "Independent Evaluation Schema — Knowledge 000",
  "description": "Draft report for musical knowledge development and transfer evaluation, separate from communication scoring.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "evaluation_id", "task", "independence", "rubric", "evidence", "verdict", "limitations"],
  "properties": {
    "schema": { "const": "IES-K000" },
    "evaluation_id": { "type": "string", "minLength": 1 },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_refs", "capabilities_tested", "held_out_material"],
      "properties": {
        "claim_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "capabilities_tested": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["identify", "explain", "generalize", "teach", "challenge", "counterexample-robustness", "epistemic-calibration"] }
        },
        "held_out_material": { "type": "boolean" }
      }
    },
    "independence": {
      "type": "object",
      "required": ["evaluator_id", "evaluator_version", "candidate_authored_verdict", "rationale"],
      "properties": {
        "evaluator_id": { "type": "string", "minLength": 1 },
        "evaluator_version": { "type": "string", "minLength": 1 },
        "candidate_authored_verdict": { "const": false },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "rubric": {
      "type": "object",
      "required": ["preregistered", "criteria", "thresholds"],
      "properties": {
        "preregistered": { "type": "boolean" },
        "criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "thresholds": { "type": "object" }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "ref", "summary"],
        "properties": {
          "kind": { "enum": ["response", "application", "transfer", "counterexample", "baseline", "other"] },
          "ref": { "type": "string", "format": "uri-reference" },
          "summary": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "verdict": {
      "type": "object",
      "required": ["status", "summary", "recommended_epistemic_state"],
      "properties": {
        "status": { "enum": ["pass", "fail", "inconclusive", "exploratory"] },
        "summary": { "type": "string", "minLength": 1 },
        "recommended_epistemic_state": { "enum": ["E", "W", "H", "?"] }
      },
      "additionalProperties": false
    },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
