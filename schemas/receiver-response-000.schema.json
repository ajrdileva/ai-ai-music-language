{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ajrdileva/ai-ai-music-language/blob/main/schemas/receiver-response-000.schema.json",
  "title": "Transmission Receiver Response 000",
  "description": "Draft cold-start response containing reconstructed events and uncertainty.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "transmission_id", "protocol", "reconstructed_events", "uncertainty", "context_used"],
  "properties": {
    "schema": { "const": "RECEIVER-RESPONSE-000" },
    "transmission_id": { "type": "string", "pattern": "^T[0-9]{3,}$" },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "recovered_without_extra_context"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "recovered_without_extra_context": { "type": "boolean" }
      }
    },
    "reconstructed_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "pitch", "onset_tick", "duration_tick", "velocity", "confidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "pitch": { "type": "integer", "minimum": 0, "maximum": 127 },
          "onset_tick": { "type": "integer", "minimum": 0 },
          "duration_tick": { "type": "integer", "minimum": 1 },
          "velocity": { "type": "integer", "minimum": 0, "maximum": 127 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "uncertainty": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "context_used": {
      "type": "array",
      "description": "Every artifact, document, prompt, or other source consulted by the receiver.",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
